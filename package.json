{
  "name": "radiologie-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An inspectable, local-first radiology study PWA. No runtime services or build framework.",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "studio": "node tools/serve.mjs --studio",
    "prepare:studio": "node tools/prepare-studio.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "release": "node tools/release.mjs"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
